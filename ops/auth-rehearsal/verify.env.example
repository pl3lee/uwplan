# Install as a mode-0600 operator file. Plaintext values are never emitted.
UWPLAN_REHEARSAL_RUN_ID=20260802T210000000Z
UWPLAN_REHEARSAL_URL=https://v2.uwplan.com
UWPLAN_REHEARSAL_APP_ENV_FILE=/etc/uwplan/rehearsal-app.env
UWPLAN_REHEARSAL_ATTESTATION_FILE=/var/lib/uwplan-migration/20260802T210000000Z/auth-browser-attestation.json
# Both files are created by the accepted candidate workflow and must remain
# root-owned mode 0600. The verifier hashes and cross-checks them.
UWPLAN_INTEGRITY_ACCEPTED_FILE=/var/lib/uwplan-migration/20260802T210000000Z/integrity-accepted.json
UWPLAN_AUTH_SCRUB_MARKER_FILE=/var/lib/uwplan-migration/20260802T210000000Z/auth-artifact-scrub-accepted.json
# Created by the guarded start and checked against the current live container.
UWPLAN_AUTH_START_MARKER_FILE=/var/lib/uwplan-migration/20260802T210000000Z/auth-rehearsal-started.json
UWPLAN_REHEARSAL_BASIC_USER=REPLACE_WITH_NAMED_TESTER
UWPLAN_REHEARSAL_BASIC_PASSWORD=REPLACE_WITH_20_CHARACTER_OR_LONGER_PASSWORD
# Dedicated Google rehearsal identity.
UWPLAN_GOOGLE_TEST_EMAIL=REPLACE_WITH_GOOGLE_REHEARSAL_EMAIL
UWPLAN_GOOGLE_WRITE_MARKER=chrome-persistence-20260802T210000000Z
# May be an existing GitHub account. For the success path, its email must not
# already belong to a user in this disposable candidate database.
UWPLAN_GITHUB_TEST_EMAIL=REPLACE_WITH_GITHUB_IDENTITY_EMAIL
UWPLAN_GITHUB_WRITE_MARKER=iphone-persistence-20260802T210000000Z
UWPLAN_PRODUCTION_AUTH_SECRET_SHA256=REPLACE_WITH_SHA256
UWPLAN_PRODUCTION_AUTH_GOOGLE_ID_SHA256=REPLACE_WITH_SHA256
UWPLAN_PRODUCTION_AUTH_GOOGLE_SECRET_SHA256=REPLACE_WITH_SHA256
UWPLAN_PRODUCTION_AUTH_GITHUB_ID_SHA256=REPLACE_WITH_SHA256
UWPLAN_PRODUCTION_AUTH_GITHUB_SECRET_SHA256=REPLACE_WITH_SHA256
