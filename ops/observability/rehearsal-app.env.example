# Add only to the protected v2.uwplan.com application environment. Never add
# these values to production.
UWPLAN_DEPLOYMENT_ENVIRONMENT=rehearsal
UWPLAN_REHEARSAL_FAILURE_CONTROL_ENABLED=true
UWPLAN_REHEARSAL_HOST=v2.uwplan.com
UWPLAN_REHEARSAL_FAILURE_CONTROL_TOKEN=replace-with-at-least-32-random-characters
UWPLAN_REHEARSAL_FAILURE_STATE_FILE=/tmp/uwplan-rehearsal-readiness.json
