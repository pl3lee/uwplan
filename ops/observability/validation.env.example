# Install as a mode-0600 file outside the repository. This command refuses the
# production apex and only operates against the rehearsal environment.
UWPLAN_VALIDATION_ENVIRONMENT=rehearsal
UWPLAN_READINESS_URL=https://v2.uwplan.com/api/ready
UWPLAN_GRAFANA_URL=https://grafana.example.ts.net
UWPLAN_GRAFANA_TOKEN=replace-with-scoped-grafana-service-token
UWPLAN_GRAFANA_ALERT_RULE_UID=uwplan-rehearsal-readiness
UWPLAN_GRAFANA_CONTACT_POINT_UID=uwplan-discord-rehearsal
UWPLAN_PROMETHEUS_DATASOURCE_UID=prometheus
UWPLAN_LOKI_DATASOURCE_UID=loki
UWPLAN_TEMPO_DATASOURCE_UID=tempo
UWPLAN_DISCORD_API_URL=https://discord.com/api/v10/
UWPLAN_DISCORD_CHANNEL_ID=replace-with-private-channel-id
UWPLAN_DISCORD_BOT_TOKEN=replace-with-read-only-channel-bot-token
UWPLAN_FAILURE_CONTROL_URL=https://v2.uwplan.com/api/rehearsal/readiness-control
UWPLAN_FAILURE_CONTROL_TOKEN=replace-with-the-same-strong-rehearsal-control-token
RELEASE_DIGEST=sha256:replace-with-64-lowercase-hex-characters
RELEASE_REVISION=replace-with-source-revision
UWPLAN_VALIDATION_PRIVATE_SENTINEL=replace-with-a-synthetic-private-sentinel
