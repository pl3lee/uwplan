# Install as a root-owned mode-0600 file outside the repository.
# These URLs must resolve through the host's Tailscale network.
UWPLAN_REMOTE_OTLP_ENDPOINT=unraid-hosting-vps-2.example.ts.net:4317
UWPLAN_REMOTE_OTLP_TOKEN=replace-with-otel-bearer-token
UWPLAN_REMOTE_LOKI_URL=https://unraid-hosting-vps-2.example.ts.net/loki/api/v1/push
UWPLAN_REMOTE_LOKI_TOKEN=replace-with-loki-bearer-token
UWPLAN_REMOTE_PROMETHEUS_URL=https://unraid-hosting-vps-2.example.ts.net/api/v1/push
UWPLAN_REMOTE_PROMETHEUS_TOKEN=replace-with-prometheus-bearer-token
UWPLAN_EXTERNAL_READINESS_URL=https://v2.uwplan.com/api/ready
