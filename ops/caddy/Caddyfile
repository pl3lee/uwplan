(uwplan_backend) {
	reverse_proxy 127.0.0.1:5000 {
		health_uri /api/live
		health_status 200
	}
}

{$UWPLAN_CADDY_APEX:uwplan.com} {
	{$UWPLAN_CADDY_TLS_DIRECTIVE:}
	import uwplan_backend
}

{$UWPLAN_CADDY_WWW:www.uwplan.com} {
	{$UWPLAN_CADDY_TLS_DIRECTIVE:}
	redir {$UWPLAN_CADDY_CANONICAL_URL:https://uwplan.com}{uri} permanent
}
