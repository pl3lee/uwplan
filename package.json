{
  "name": "uwplan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "make -C api build && pnpm build:web",
    "check": "make -C api vet && pnpm check:web",
    "test": "make -C api test && pnpm test:web",
    "test:e2e": "node e2e/run.mjs",
    "test:deploy": "python3 -m unittest discover -s tests -p test_production_deploy.py",
    "db:migrate": "make -C api migrate",
    "db:seed": "make -C api seed",
    "courses:update": "make -C api courses-update",
    "dev:api": "make -C api run",
    "dev:web": "pnpm --filter @uwplan/web dev",
    "build:web": "pnpm --filter @uwplan/web build",
    "check:web": "pnpm --filter @uwplan/web typecheck && pnpm --filter @uwplan/web lint",
    "test:web": "pnpm --filter @uwplan/web test",
    "generate": "make -C api generate && pnpm generate:web",
    "generate:web": "pnpm --filter @uwplan/web api:generate"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "postgres": "3.4.9",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  }
}
